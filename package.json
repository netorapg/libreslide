{
  "name": "libreslide",
  "version": "0.1.3",
  "description": "Slides livres em Markdown, com editor no navegador, temas e templates de instituição.",
  "keywords": [
    "slides",
    "presentation",
    "apresentacao",
    "markdown",
    "editor",
    "astro",
    "cli",
    "templates"
  ],
  "license": "MIT",
  "author": "netorapg",
  "homepage": "https://github.com/netorapg/libreslide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netorapg/libreslide.git"
  },
  "bugs": {
    "url": "https://github.com/netorapg/libreslide/issues"
  },
  "type": "module",
  "bin": {
    "libreslide": "bin/libreslide.mjs"
  },
  "files": [
    "bin/",
    "editor/",
    "src/",
    "workspace.mjs",
    "astro.config.mjs",
    "tsconfig.json",
    "slides/exemplo/",
    "templates/instituicao-exemplo/",
    "themes/oceano.yaml",
    "public/img/abstrato.svg"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "editor": "astro dev --open /__editor/",
    "build": "astro build",
    "preview": "astro preview",
    "nova": "node scripts/nova.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.3.2"
  }
}
