---
import DeckView from '../components/DeckView.astro';
import { getDecks, type Deck } from '../lib/decks';

export async function getStaticPaths() {
  const decks = await getDecks();
  return decks.map((deck) => ({ params: { deck: deck.name }, props: { deck } }));
}

const { deck } = Astro.props as { deck: Deck };
---

<DeckView deck={deck} />
