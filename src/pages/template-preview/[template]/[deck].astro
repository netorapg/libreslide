---
import DeckView from '../../../components/DeckView.astro';
import { applyTemplate, getDecks, getTemplates, type Deck } from '../../../lib/decks';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const [decks, templates] = await Promise.all([getDecks(), getTemplates()]);
  return Object.keys(templates).flatMap((template) =>
    decks.map((deck) => ({
      params: { template, deck: deck.name },
      props: { deck: applyTemplate(deck, templates, template) },
    })),
  );
}

const { deck } = Astro.props as { deck: Deck };
---

<DeckView deck={deck} />
